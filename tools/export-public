#!/usr/bin/env bash
# Monta a versão pública do repositório numa pasta à parte, com histórico próprio.
# Uso: tools/export-public <pasta de destino> "<mensagem do commit>"
#
# A branch de trabalho, com as notas de desenho e o histórico, fica local. O que vai a público é
# o conteúdo versionado menos `docs/`, num commit assinado com o e-mail anônimo do GitHub. Antes
# do commit, cada arquivo é conferido contra padrões genéricos (caminho de pasta pessoal, e-mail
# pessoal) e contra uma lista de termos privados que fica fora do repositório, em
# ~/.config/fullchico-harness/private-terms (um por linha).
set -uo pipefail

[ "$#" -eq 2 ] || { echo 'uso: tools/export-public <pasta de destino> "<mensagem do commit>"' >&2; exit 2; }
SRC="$(cd "$(dirname "$0")/.." && pwd -P)"
DEST="$1" MESSAGE="$2"
AUTHOR_NAME="FullChico"
AUTHOR_EMAIL="62688167+fullchico@users.noreply.github.com"
TERMS="${HARNESS_PRIVATE_TERMS:-$HOME/.config/fullchico-harness/private-terms}"

cd "$SRC" || exit 1
[ -z "$(git status --porcelain)" ] || { echo "export-public: há alteração sem commit; faça o commit antes." >&2; exit 1; }
[ -f "$TERMS" ] || { echo "export-public: falta a lista de termos privados em $TERMS." >&2; exit 1; }

mkdir -p "$DEST" && cd "$DEST" || exit 1
[ -d .git ] || git init -q -b main
# Sai tudo o que estava, menos o histórico: arquivo removido na origem some no destino.
find . -mindepth 1 -maxdepth 1 ! -name .git -exec rm -rf {} +
(cd "$SRC" && git ls-files -z | grep -zv '^docs/' | xargs -0 tar -cf - ) | tar -xf - || exit 1

python3 -I - "$DEST" "$TERMS" <<'PY' || { echo "export-public: nada foi commitado." >&2; exit 1; }
import os, re, sys
dest, terms_file = sys.argv[1], sys.argv[2]
terms = [t.strip().lower() for t in open(terms_file, encoding="utf-8") if t.strip() and not t.startswith("#")]
generic = [re.compile(r"/Users/[a-z]|/home/[a-z]"), re.compile(r"[\w.+-]+@(?:gmail|hotmail|outlook|yahoo|icloud)\.\w+", re.I)]
found = []
for folder, dirs, files in os.walk(dest):
    dirs[:] = [d for d in dirs if d != ".git"]
    for name in files:
        path = os.path.join(folder, name)
        rel = os.path.relpath(path, dest)
        text = open(path, encoding="utf-8", errors="ignore").read()
        low = (rel + "\n" + text).lower()
        for term in terms:
            if term in low:
                found.append(f"{rel}: termo privado")
        if rel != os.path.join("tests", "test_package.py"):
            for pattern in generic:
                if pattern.search(text):
                    found.append(f"{rel}: caminho ou e-mail pessoal")
for line in sorted(set(found)):
    print("  " + line, file=sys.stderr)
if found:
    print("export-public: conteúdo pessoal no que iria a público.", file=sys.stderr)
sys.exit(1 if found else 0)
PY

git add -A
if git diff --cached --quiet; then echo "export-public: nada mudou desde a última exportação."; exit 0; fi
git -c user.name="$AUTHOR_NAME" -c user.email="$AUTHOR_EMAIL" -c core.hooksPath=/dev/null commit -q -m "$MESSAGE" || exit 1
echo "Exportado para $DEST ($(git rev-parse --short HEAD)), $(git ls-files | wc -l | tr -d ' ') arquivos."
