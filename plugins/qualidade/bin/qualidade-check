#!/usr/bin/env bash
# Roda a checagem de qualidade do projeto (o comando de .claude/trilho.json) na raiz do repositório.
# Não grava nada: quem carimba é o hook do plugin, depois que este comando termina bem.
root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "qualidade-check: isto não é um repositório git." >&2
  exit 2
}
cfg="$root/.claude/trilho.json"
cmd=$(python3 -c '
import json, sys
try:
    print(json.load(open(sys.argv[1]))["qualidade"]["comando"])
except Exception:
    pass
' "$cfg" 2>/dev/null)
if [ -z "$cmd" ]; then
  cat >&2 <<MSG
qualidade-check: a checagem deste projeto não está configurada.
Crie $cfg com o comando que confere o projeto, por exemplo:
  {"qualidade": {"comando": "pnpm lint && pnpm test"}}
Depois faça o commit e rode qualidade-check de novo.
MSG
  exit 2
fi
cd "$root" || exit 2
bash -c "$cmd"
code=$?
echo
if [ "$code" -eq 0 ]; then
  echo "qualidade: passou"
else
  echo "qualidade: FALHOU ($cmd)"
fi
exit "$code"
