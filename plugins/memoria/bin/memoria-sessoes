#!/usr/bin/env bash
# Lê as transcrições de sessão deste projeto: consumo por papel e resumo enxuto de cada sessão.
# Uso: memoria-sessoes <sessions [--all]|digest <id> <arquivo>|usage [<id>...]|mark <id>...|propose <assunto> <arquivo>|proposals>
set -uo pipefail
dir=$(cd "$(dirname "$0")/.." && pwd -P)
root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "memoria-sessoes: fora de um repositório git" >&2; exit 1; }
exec python3 -I "$dir/scripts/learn.py" "$root" "$@"
