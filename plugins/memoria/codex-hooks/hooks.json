{
  "hooks": {
    "SessionStart": [
      {"hooks": [
        {"type": "command", "command": "python3 -I \"${PLUGIN_ROOT}/scripts/codex_session_context.py\"", "timeout": 30}
      ]}
    ],
    "SubagentStop": [
      {"matcher": "^memoria-extrator$", "hooks": [
        {"type": "command", "command": "python3 -I \"${PLUGIN_ROOT}/scripts/codex_candidates.py\"", "timeout": 30}
      ]}
    ]
  }
}
