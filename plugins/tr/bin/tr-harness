#!/usr/bin/env bash
# O CLI do harness dentro da sessão, sempre na versão do plugin instalado (o `npx` sem versão traria outra).
# `tr-harness owner <args>` imprime o comando exato para o terminal do dono, com a versão fixada no projeto.
dir=$(cd "$(dirname "$0")/.." && pwd)
cmd=$1; shift 2>/dev/null
if [ "$cmd" = "--demand" ]; then
  # Da estação, o maestro olha um trem que viaja em outra pasta. Só leitura e socorro: o que escreve (aceite,
  # registro, partida) roda de dentro da pasta da demanda, onde os hooks e a aprovação do dono a enxergam.
  slug=$1; shift 2>/dev/null
  case "$1 $2" in
    "status "|"evidence "|"ports "|"orchestrate --status"|"orchestrate --read"|"orchestrate --stop"|"orchestrate --wait") ;;
    *) echo "tr-harness --demand <slug> aceita: status | evidence | ports | orchestrate --wait|--status|--read|--stop. O resto roda de dentro da pasta da demanda (EnterWorktree)." >&2; exit 2 ;;
  esac
  target=$(python3 -I "$dir/scripts/demand_cli.py" path "$slug") || exit 1
  cd "$target" || exit 1
  cmd=$1; shift
fi
case "$cmd" in
  l)       exec python3 -I "$dir/scripts/watch_cli.py" --once "$@" ;;
  v)       exec python3 -I "$dir/scripts/watch_cli.py" --view "$@" ;;
  a)       exec python3 -I "$dir/scripts/watch_cli.py" --attach "$@" ;;
  w)       exec python3 -I "$dir/scripts/watch_cli.py" "$@" ;;
  ""|help|-h|--help)
    cat <<'TXT'
tr: a CLI do FullChico Harness neste projeto.   uso: ./tr <comando> [<sub-comando>]

  ./tr l                 o que está executando agora: tickets, topologia, trilhos e cada terminal
  ./tr w                 o mesmo, ao vivo (Ctrl-C sai; nada é interrompido)
  ./tr v                 abre todos os agentes lado a lado, ao vivo, só para olhar (q fecha a visão)
  ./tr a [nome]          entra no terminal de um agente (sem nome, lista para escolher; sair: Ctrl-b d)
  ./tr doctor            a máquina e o projeto têm o que o plugin precisa? o que falta e como resolver
  ./tr status            tickets e agentes da demanda
  ./tr deliver           valida os portões e os passaportes da entrega
  ./tr cost              o que a entrega custou
  ./tr gates <...>       portões do projeto: --check, --accept, --set, --register, --prepare-seat ...
  ./tr models <...>      modelos por papel: show, configure ...
  ./tr demand <...>      demandas em paralelo: open, list, path
  ./tr ports | evidence  portas no ar e a pasta de evidência do estado atual

Os agentes usam os mesmos comandos como `tr-harness <comando>` (mais os de coordenação: orchestrate, report,
models run|wait|integrate|grant|refuse, balance).
TXT
    exit 0 ;;
  gates)   exec python3 -I "$dir/scripts/gates_cli.py" "$@" ;;
  models)  exec python3 -I "$dir/scripts/models_cli.py" "$@" ;;
  cost)    exec python3 -I "$dir/scripts/cost_report.py" "$@" ;;
  deliver) exec python3 -I "$dir/scripts/gate_cli.py" delivery ;;
  owner)   exec python3 -I "$dir/scripts/registry.py" owner "$@" ;;
  status)  exec python3 -I "$dir/scripts/status.py" ;;
  skill)   exec python3 -I "$dir/scripts/skill_path.py" "$@" ;;
  wait)    exec python3 -I "$dir/scripts/wait_cli.py" "$@" ;;
  balance) exec python3 -I "$dir/scripts/balance_cli.py" "$@" ;;
  evidence|ports) exec python3 -I "$dir/scripts/evidence_cli.py" "$cmd" "$@" ;;
  report)  exec python3 -I "$dir/scripts/report_cli.py" "$@" ;;
  orchestrate) exec python3 -I "$dir/scripts/orchestrate_cli.py" "$@" ;;
  doctor)  exec python3 -I "$dir/scripts/doctor_cli.py" "$@" ;;
  watch)   exec python3 -I "$dir/scripts/watch_cli.py" "$@" ;;
  demand)  exec python3 -I "$dir/scripts/demand_cli.py" "$@" ;;
  *) echo "comando desconhecido: $cmd (veja \`./tr help\`)" >&2; echo "uso: tr-harness gates|models|cost|deliver|status|skill|wait|balance|orchestrate|demand|report|evidence|ports|watch|doctor|owner <args>" >&2; exit 2 ;;
esac
