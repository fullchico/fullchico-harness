{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "fullchico": {
      "source": {
        "source": "github",
        "repo": "FullChico/fullchico-harness",
        "ref": "__VERSION__"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "enabledPlugins": {
    "harness@fullchico": true,
    "mattpocock-skills@claude-plugins-official": true,
    "ponytail@ponytail": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.harness/hooks/service_guard.py\"",
            "timeout": 30,
            "statusMessage": "Conferindo guard de comandos..."
          },
          {
            "type": "command",
            "command": "if command -v rtk >/dev/null 2>&1; then rtk hook claude; fi"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.harness/hooks/dispatch_guard.py\"",
            "timeout": 30,
            "statusMessage": "Conferindo pedido ao revisor..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.harness/hooks/managed_guard.py\"",
            "timeout": 30,
            "statusMessage": "Conferindo arquivos gerenciados..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^harness:(seguranca|revisor)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.harness/hooks/gate_stamp.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyWrite": [
        ".harness",
        "harness.conf",
        "harness.d",
        "CLAUDE.md",
        "docs/agents",
        "orca.yaml",
        ".conductor"
      ],
      "allowWrite": [
        "~/.npm",
        "~/Library/pnpm",
        "~/.local/share/pnpm",
        "~/.yarn",
        "~/.bun/install/cache"
      ]
    },
    "excludedCommands": [
      ".harness/up",
      "./.harness/up",
      ".harness/down",
      "./.harness/down",
      ".harness/destroy",
      "./.harness/destroy",
      ".harness/push",
      "./.harness/push",
      ".harness/push --force",
      "./.harness/push --force",
      ".harness/fetch",
      "./.harness/fetch",
      ".harness/pr *",
      "./.harness/pr *"
    ],
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "registry.npmjs.org"
      ],
      "deniedDomains": [
        "github.com",
        "*.github.com"
      ]
    }
  },
  "permissions": {
    "deny": [
      "Edit(/.harness/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/CLAUDE.md)",
      "Edit(/docs/agents/**)",
      "Edit(/harness.conf)",
      "Edit(/harness.d/**)"
    ],
    "ask": [
      "Bash(.harness/up)",
      "Bash(./.harness/up)",
      "Bash(.harness/down)",
      "Bash(./.harness/down)",
      "Bash(.harness/destroy)",
      "Bash(./.harness/destroy)"
    ]
  }
}
