#!/usr/bin/env bash
# Sobe a infra da feature deste worktree. Só a infra: migration, seed e app são
# código do projeto e rodam depois, por .harness/prepare e .harness/dev.
#
# Este script roda fora do sandbox do Bash, sem pergunta ao dono. Por isso ele não
# executa nenhum comando do projeto, e recusa um compose que dê a um contêiner
# acesso a algo fora da pasta do projeto.
set -uo pipefail
. "$(dirname "$0")/env-common.sh"

need_compose
(cd "$ROOT" && "$HERE/worktree-env") || exit $?

RECORD="$(env_record)"
if [ -f "$RECORD" ]; then
  OWNER="$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1])).get("worktree",""))' "$RECORD" 2>/dev/null || true)"
  if [ -n "$OWNER" ] && [ "$OWNER" != "$ROOT" ] && [ -n "$(compose ps -q 2>/dev/null)" ]; then
    echo "O ambiente desta feature já está de pé, levantado a partir de $OWNER. Nada foi recriado."
    exit 0
  fi
fi

PROTECT="${RECORD%.json}.protect.json"
rm -f "$PROTECT"  # refeito abaixo, a partir do compose de agora
CONFIG="$(compose config --format json)" || die "o Docker não conseguiu ler o compose ($COMPOSE_FILE)."
python3 -I "$HERE/compose_check.py" "$ROOT" <<EOT || exit 1
$CONFIG
EOT

# Contêiner que monta a pasta do projeto com escrita recebe os trilhos só para leitura. O arquivo
# fica no estado do harness, fora do projeto, onde o agente não grava.
mkdir -p "$(dirname "$PROTECT")"
python3 -I "$HERE/compose_check.py" "$ROOT" --protect > "$PROTECT.tmp" <<EOT || die "não consegui montar a proteção dos trilhos."
$CONFIG
EOT
if [ "$(cat "$PROTECT.tmp")" = "{}" ]; then rm -f "$PROTECT.tmp"; else mv "$PROTECT.tmp" "$PROTECT"; fi

echo "Ambiente $(env_get COMPOSE_PROJECT_NAME):"
python3 -I "$HERE/compose_check.py" "$ROOT" --summary <<EOT
$CONFIG
EOT

BASE="$(sed -n 's/^[A-Z0-9_]*_PORT=//p' "$ROOT/.env" | sort -n | sed -n 1p)"
mkdir -p "$(dirname "$RECORD")"
python3 -I - "$RECORD" "$ROOT" "$BASE" <<'PY'
import json, sys
with open(sys.argv[1], "w", encoding="utf-8") as f:
    json.dump({"worktree": sys.argv[2], "base": int(sys.argv[3])}, f)
PY

if ! compose up -d --wait; then
  rm -f "$RECORD"
  die "o ambiente não subiu. Veja a saída do Docker acima."
fi
echo "Ambiente de pé. Próximos passos, se o projeto usar: .harness/prepare e .harness/dev"
