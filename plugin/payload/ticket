#!/usr/bin/env bash
# Muda o estado de tickets e faz o commit, de uma vez.
# Uso: .harness/ticket claim  <pasta da spec> <NN>...            open -> claimed
#      .harness/ticket reopen <pasta da spec> <NN> "<motivo>"   qualquer -> open
set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd -P)"
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "ticket: fora de um repositório git." >&2; exit 2; }
cd "$ROOT" || exit 1
exec python3 -I - "$HERE" "$@" <<'PY'
import os
import re
import subprocess
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, sys.argv[1])
import tickets_check

USAGE = 'uso: ticket claim <pasta da spec> <NN>... | ticket reopen <pasta da spec> <NN> "<motivo>"\n'
args = sys.argv[2:]


def fail(message, code=1):
    sys.stderr.write(f"ticket: {message}\n")
    sys.exit(code)


if len(args) < 3 or args[0] not in ("claim", "reopen") or (args[0] == "reopen" and len(args) != 4):
    sys.stderr.write(USAGE)
    sys.exit(2)
action, spec = args[0], args[1].rstrip("/")
numbers = args[2:] if action == "claim" else [args[2]]
reason = args[3].strip() if action == "reopen" else ""
if action == "reopen" and not reason:
    fail("reabrir pede o motivo, que vai para o commit.", 2)
try:
    tickets = tickets_check.load(os.path.join(spec, "issues"))
except (ValueError, OSError) as exc:
    fail(str(exc))
chosen = []
for raw in numbers:
    if not raw.isdigit() or int(raw) not in tickets:
        fail(f"não existe o ticket {raw} em {spec}.")
    ticket = tickets[int(raw)]
    if action == "claim" and ticket["status"] != "open":
        fail(f"o ticket {int(raw):02d} está `{ticket['status']}`; só se marca como em andamento o que está `open`.")
    chosen.append((int(raw), ticket))
new = "claimed" if action == "claim" else "open"
for _, ticket in chosen:  # só depois de conferir todos: ou muda todos, ou nenhum
    with open(ticket["path"], encoding="utf-8") as f:
        lines = f.read().split("\n")
    for i, line in enumerate(lines[:tickets_check.HEADER_LINES]):
        if re.match(r"^Status:", line):
            lines[i] = f"Status: {new}"
            break
    with open(ticket["path"], "w", encoding="utf-8") as f:
        f.write("\n".join(lines))
names = ", ".join(f"{n:02d}" for n, _ in chosen)
paths = [t["path"] for _, t in chosen]
subject = f"chore(tickets): {action} {names}"
message = ["-m", subject] + (["-m", reason] if reason else [])
subprocess.run(["git", "add", "--", *paths], check=True)
done = subprocess.run(["git", "commit", "-q", *message, "--", *paths])
if done.returncode != 0:
    fail("o commit falhou; veja a saída do git acima.")
print(f"{subject}")
PY
