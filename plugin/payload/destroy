#!/usr/bin/env bash
# Remove o ambiente da feature deste worktree: contêineres, volumes e imagens locais.
# Apaga os dados. Nunca roda sobre o ambiente do checkout principal.
set -uo pipefail
. "$(dirname "$0")/env-common.sh"

cd "$ROOT" || exit 1
MAIN="$(git worktree list --porcelain | sed -n '1s/^worktree //p')"
[ "$(cd "$MAIN" && pwd -P)" != "$ROOT" ] || die "este é o checkout principal; o ambiente dele não é removido por aqui."

need_compose
"$HERE/worktree-env" >/dev/null || exit $?
CONTEXT="$(env_get HARNESS_ENV_CONTEXT)"
MAIN_CONTEXT="$(sed -n 's/^HARNESS_ENV_CONTEXT=//p' "$MAIN/.env" 2>/dev/null | sed -n 1p)"
[ -n "$MAIN_CONTEXT" ] || MAIN_CONTEXT="$(basename "$MAIN" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]\{1,\}/-/g; s/^-*//; s/-*$//')"
[ "$CONTEXT" != "$MAIN_CONTEXT" ] || die "este worktree usa o mesmo ambiente do checkout principal ($CONTEXT); não é removido por aqui."

"$HERE/down" >/dev/null 2>&1 || true
compose down -v --rmi local --remove-orphans || die "o Docker não removeu o ambiente."
rm -f "$(env_record)"
echo "Ambiente $(env_get COMPOSE_PROJECT_NAME) removido."
