#!/usr/bin/env bash
# Grava o harness.conf que o agente propôs e o guard acabou de conferir.
#
# O agente escreve a proposta em .harness-run/harness.conf e roda `.harness/conf-apply`,
# sem argumento. O guard confere o formato e guarda a cópia conferida num lugar onde o
# agente não grava. Este script aplica essa cópia, uma vez. Não há pergunta ao dono: o
# arquivo é versionado e passa pelos revisores, como o resto da entrega.
set -uo pipefail
. "$(dirname "$0")/env-common.sh"

APPROVED="$(python3 -I "$HERE/hooks/common.py" conf-approval "$ROOT")" || die "fora de um repositório git."
[ -f "$APPROVED" ] || die "não há proposta conferida. Escreva .harness-run/harness.conf e rode exatamente: .harness/conf-apply"

cp "$APPROVED" "$ROOT/harness.conf.$$.tmp" && mv "$ROOT/harness.conf.$$.tmp" "$ROOT/harness.conf" || die "não consegui gravar o harness.conf."
rm -f "$APPROVED"
echo "harness.conf gravado."

if [ -n "$(conf_get SERVICES)" ]; then
  "$HERE/worktree-env" || exit $?
  echo "Portas gravadas no .env."
fi
echo "Faça o commit do harness.conf."
