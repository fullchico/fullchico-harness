#!/usr/bin/env bash
# Prepara um worktree recém-criado de uma feature. Chamado pelo Orca e pelo
# Conductor ao abrir o worktree, e pode ser rodado à mão. Não sobe ambiente.
set -uo pipefail
. "$(dirname "$0")/env-common.sh"

cd "$ROOT" || exit 1
# O .env não é versionado. Um worktree de feature começa com o do checkout principal; um
# worktree de agente, que fica dentro de uma feature, começa com o da feature.
AGENT_WORKTREE=""
case "$ROOT" in
  */.claude/worktrees/*) AGENT_WORKTREE=1; SOURCE="${ROOT%%/.claude/worktrees/*}" ;;
  *) SOURCE="$(git worktree list --porcelain | sed -n '1s/^worktree //p')" ;;
esac
if [ ! -f .env ] && [ -n "$SOURCE" ] && [ -f "$SOURCE/.env" ] && [ "$(cd "$SOURCE" && pwd -P)" != "$ROOT" ]; then
  cp "$SOURCE/.env" .env
fi

"$HERE/worktree-env" || exit $?

# Guarda o caminho deste worktree: é por ele que as sessões são achadas depois que ele for removido.
"$HERE/learn" remember >/dev/null 2>&1 || true

INSTALL="$(conf_get INSTALL_CMD)"
if [ -n "$INSTALL" ]; then
  bash -c "$INSTALL" || exit $?
fi

# Plugin declarado no projeto não se instala sozinho numa máquina nova.
if [ -z "$AGENT_WORKTREE" ] && [ -z "${HARNESS_SKIP_PLUGIN:-}" ] && command -v claude >/dev/null 2>&1 && [ -f .claude/settings.json ]; then
  python3 -I - <<'PY' | while IFS= read -r plugin; do claude plugin install "$plugin" --scope project >/dev/null 2>&1 || echo "setup-worktree: não instalei o plugin $plugin; rode à mão." >&2; done
import json
for name, enabled in json.load(open(".claude/settings.json")).get("enabledPlugins", {}).items():
    if enabled:
        print(name)
PY
fi
exit 0
