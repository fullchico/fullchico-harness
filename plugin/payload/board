#!/usr/bin/env bash
# Painel da entrega: gera .harness-run/painel.html, que o dono abre no navegador e acompanha
# (a página recarrega sozinha). Só lê o repositório e o estado; a única escrita é a página.
# Uso: .harness/board                    gera a página e imprime o caminho
#      .harness/board --text             o mesmo retrato em texto, numa tela
#      .harness/board --json             os mesmos dados
#      .harness/board --watch [segundos] regenera em laço (padrão 5 s) até Ctrl+C: rode no seu terminal
set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd -P)"
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || ROOT="$(cd "$HERE/.." && pwd -P)"
exec python3 -I "$HERE/board.py" "$ROOT" "$@"
