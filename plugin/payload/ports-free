#!/usr/bin/env python3
"""Encerra processo esquecido numa porta desta feature.

Uso: .harness/ports-free

As portas da feature são as chaves `*_PORT` do `.env`. Quem escuta numa delas a partir de uma
pasta que não é a da feature (a cópia temporária de um revisor, outro worktree) é um resto de
execução: impede a aplicação de subir e ninguém dentro do sandbox consegue encerrá-lo. O que
roda da pasta da feature e os contêineres do ambiente não são tocados.
"""
import os
import re
import signal
import subprocess
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "hooks"))
import common  # noqa: E402


def out(*args):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=15).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def main() -> int:
    root = common.repo_root(os.getcwd())
    if not root:
        return 0
    feature = os.path.realpath(common.feature_root(root))
    try:
        with open(os.path.join(feature, ".env"), encoding="utf-8") as f:
            ports = sorted({m.group(1) for m in re.finditer(r"(?m)^[A-Z0-9_]*_PORT=[\"']?(\d{2,5})[\"']?\s*$", f.read())})
    except OSError:
        return 0
    for port in ports:
        for pid in re.findall(r"(?m)^p(\d+)$", out("lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN", "-Fp")):
            where = re.search(r"(?m)^n(.+)$", out("lsof", "-a", "-p", pid, "-d", "cwd", "-Fn"))
            cwd = os.path.realpath(where.group(1)) if where else ""
            name = out("ps", "-o", "comm=", "-p", pid).strip()
            if "docker" in name.lower() or cwd == feature or cwd.startswith(feature + os.sep):
                continue
            try:
                os.kill(int(pid), signal.SIGTERM)
            except (OSError, ValueError):
                continue
            print(f"encerrado: processo {pid} ({os.path.basename(name)}) na porta {port}, rodando de {cwd or 'pasta desconhecida'}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
