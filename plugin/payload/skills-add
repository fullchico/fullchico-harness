#!/usr/bin/env bash
# Instala no projeto uma skill pública, copiada e fixada no skills-lock.json.
# Uso: .harness/skills-add <dono/repositório> <skill>
#
# Roda fora do sandbox e sempre pergunta ao dono: uma skill instalada passa a orientar todo
# agente do projeto. O agente não escreve em .claude/skills/ por outro caminho.
set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd -P)"
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "skills-add: fora de um repositório git." >&2; exit 2; }
[ "$#" -eq 2 ] || { echo "uso: skills-add <dono/repositório> <skill>" >&2; exit 2; }
python3 -I -c 'import sys
sys.dont_write_bytecode = True
sys.path.insert(0, sys.argv[1])
import skills_remote
sys.exit(0 if skills_remote.valid_repo(sys.argv[2]) and skills_remote.valid_term(sys.argv[3]) else 2)' "$HERE" "$1" "$2" \
  || { echo "skills-add: repositório ou nome de skill inválido." >&2; exit 2; }
command -v npx >/dev/null 2>&1 || { echo "skills-add: falta o npx." >&2; exit 1; }
cd "$ROOT" || exit 1
npx -y skills add "$1" -s "$2" -a claude-code -y --copy </dev/null || { echo "skills-add: a instalação falhou." >&2; exit 1; }
echo "Skill $2 instalada em .claude/skills/$2. Faça o commit de .claude/skills e do skills-lock.json."
