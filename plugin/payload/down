#!/usr/bin/env bash
# Para o app em segundo plano e os contêineres da feature. Mantém os dados.
set -uo pipefail
. "$(dirname "$0")/env-common.sh"

kill_tree() {  # o processo e tudo o que ele iniciou: o app sobe filhos, que seguravam as portas
  local child
  for child in $(pgrep -P "$1" 2>/dev/null); do kill_tree "$child"; done
  kill "$1" 2>/dev/null || true
}

if PID="$(dev_pid)"; then
  kill_tree "$PID"
  kill -- "-$PID" 2>/dev/null || true  # o grupo que o dev criou: pega quem se soltou do pai
  echo "App parado (PID $PID)."
fi
rm -f "$ROOT/.harness-run/dev.pid"

[ -f "$ROOT/.env" ] || { echo "Sem .env neste worktree: não há ambiente para parar."; exit 0; }
need_compose
compose stop
