#!/usr/bin/env bash
# Para o app em segundo plano e os contêineres da feature. Mantém os dados.
set -uo pipefail
. "$(dirname "$0")/env-common.sh"

if PID="$(dev_pid)"; then
  pkill -P "$PID" 2>/dev/null || true
  kill "$PID" 2>/dev/null || true
  echo "App parado (PID $PID)."
fi
rm -f "$ROOT/.harness-run/dev.pid"

[ -f "$ROOT/.env" ] || { echo "Sem .env neste worktree: não há ambiente para parar."; exit 0; }
need_compose
compose stop
