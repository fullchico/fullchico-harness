#!/usr/bin/env bash
# Carimbo manual do dono para um portão de push, sobre o commit atual.
# Uso: .harness/approve <seguranca|revisao> "<resumo do que foi revisado>"
# Agentes são negados pelo sandbox e pela exigência de terminal: quem revisa com IA não carimba.
set -euo pipefail

GATE="${1:-}"
RESUMO="${2:-}"

usage() { echo 'uso: approve <seguranca|revisao> "<resumo>"' >&2; exit 1; }

# Sem terminal na entrada, quem está chamando não é o dono digitando.
[ -t 0 ] || { echo "approve: só roda num terminal, pelo dono. Agentes não carimbam aprovação." >&2; exit 1; }

case "$GATE" in seguranca|revisao) ;; *) usage ;; esac
[ -n "${RESUMO//[[:space:]]/}" ] || usage

HERE="$(cd "$(dirname "$0")" && pwd -P)"
STATE="$(python3 -I "$HERE/hooks/common.py" state-dir 2>/dev/null)" || {
  echo "erro: fora de um repositório git" >&2; exit 1; }
SHA="$(git rev-parse HEAD 2>/dev/null)" || { echo "erro: repositório sem commit" >&2; exit 1; }

DIR="$STATE/approvals/$GATE"
mkdir -p "$DIR"
python3 -I - "$DIR/$SHA.json" "$GATE" "$SHA" "$RESUMO" <<'PY'
import datetime, json, sys
path, gate, sha, resumo = sys.argv[1:5]
record = {"gate": gate, "sha": sha, "base": None, "status": "PASS", "resumo": resumo, "by": "owner",
          "agent_type": None, "transcript": None,
          "timestamp": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")}
with open(path, "w", encoding="utf-8") as f:
    json.dump(record, f, ensure_ascii=False, indent=2)
PY
echo "[$GATE] aprovado pelo dono para o commit $SHA"
