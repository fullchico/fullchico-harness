#!/usr/bin/env bash
# Formato do commit: `tipo(escopo): descrição`, até 80 caracteres, sem assinatura de IA.
set -uo pipefail

FILE="${1:-}"
[ -f "$FILE" ] || { echo "commit-msg: arquivo da mensagem ausente" >&2; exit 1; }

FIRST="$(grep -v '^#' "$FILE" | sed -n 1p || true)"

case "$FIRST" in
  "Merge "*|"Revert "*) exit 0 ;;
esac

PATTERN='^(feat|fix|chore|docs|refactor|test)(\([a-z0-9._/-]+\))?!?: .+'
if ! [[ "$FIRST" =~ $PATTERN ]]; then
  echo "commit recusado: o assunto precisa seguir tipo(escopo): descrição" >&2
  echo "  tipos: feat, fix, chore, docs, refactor, test. Exemplo: fix(api): keep notes multiline" >&2
  exit 1
fi
if [ "${#FIRST}" -gt 80 ]; then
  echo "commit recusado: assunto com ${#FIRST} caracteres; o limite é 80. O contexto vai no corpo." >&2
  exit 1
fi
BODY="$(grep -v '^#' "$FILE" || true)"
if grep -Eiq '^co-authored-by:.*(claude|anthropic|openai|gpt|codex|copilot|gemini)|generated with|🤖' <<EOT
$BODY
EOT
then
  echo "commit recusado: sem co-autoria nem assinatura de IA. A autoria é de quem está no git config." >&2
  exit 1
fi
exit 0
