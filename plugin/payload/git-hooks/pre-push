#!/usr/bin/env bash
# Portão de push: dois vereditos sobre o commit do topo, trava de spec e checagens.
# Vale para qualquer um que faça push: agente ou dono.
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
H="$ROOT/.harness"
COMMON="$(git rev-parse --path-format=absolute --git-common-dir)"
ZERO=0000000000000000000000000000000000000000
SPEC_GLOB='docs/specs/*/spec.md'
[ -f "$H/map.env" ] && . "$H/map.env"

approved() {  # portão, sha
  local file="$COMMON/harness/approvals/$1/$2.json"
  [ -f "$file" ] || return 1
  python3 - "$file" "$1" "$2" <<'PY'
import json, sys
try:
    with open(sys.argv[1], encoding="utf-8") as f:
        d = json.load(f)
except (OSError, ValueError):
    sys.exit(1)
sys.exit(0 if d.get("status") == "PASS" and d.get("gate") == sys.argv[2] and d.get("sha") == sys.argv[3] else 1)
PY
}

default_branch() {
  local ref
  for ref in refs/remotes/origin/HEAD refs/remotes/origin/main refs/heads/main; do
    if git rev-parse -q --verify "$ref" >/dev/null 2>&1; then echo "$ref"; return 0; fi
  done
  return 1
}

FAIL=0
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  case "$LOCAL_REF" in refs/tags/*) continue ;; esac
  [ "$LOCAL_SHA" = "$ZERO" ] && continue
  [ -n "$LOCAL_SHA" ] || continue

  for GATE in seguranca revisao; do
    if ! approved "$GATE" "$LOCAL_SHA"; then
      echo "push negado: falta a aprovação de $GATE para o commit $LOCAL_SHA." >&2
      echo "  Ela nasce do veredito do revisor sobre esse commit; commit novo pede revisão nova." >&2
      FAIL=1
    fi
  done

  RANGE="$LOCAL_SHA"
  BASE=""
  if DEFAULT="$(default_branch)"; then
    BASE="$(git merge-base "$LOCAL_SHA" "$DEFAULT" 2>/dev/null || true)"
    [ -n "$BASE" ] && RANGE="$BASE..$LOCAL_SHA"
  fi
  # Sem pipe para o grep -q: com pipefail, o grep sair cedo derruba o git log e a
  # trava deixaria de valer de forma intermitente.
  SUBJECTS="$(git log --format=%s "$RANGE")"
  if grep -Eq '^feat(\(.+\))?!?:' <<EOT
$SUBJECTS
EOT
  then
    if [ -n "$BASE" ]; then
      NAMES="$(git diff --name-only "$BASE" "$LOCAL_SHA")"
    else
      NAMES="$(git ls-tree -r --name-only "$LOCAL_SHA")"
    fi
    FOUND=0
    while IFS= read -r NAME; do
      # shellcheck disable=SC2254
      case "$NAME" in $SPEC_GLOB) FOUND=1 ;; esac
    done <<EOT
$NAMES
EOT
    if [ "$FOUND" -eq 0 ]; then
      echo "push negado: a branch tem commit feat e nenhuma spec em $SPEC_GLOB." >&2
      echo "  Toda feat entra com a spec da mudança no mesmo conjunto de commits." >&2
      FAIL=1
    fi
  fi
done

[ "$FAIL" -eq 0 ] || exit 1
"$H/validate" --profile push </dev/null || {
  echo "push negado: .harness/validate --profile push falhou." >&2
  exit 1
}
exit 0
