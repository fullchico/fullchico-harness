#!/usr/bin/env bash
# Envia a branch atual para o remoto, depois de passar pelo portão.
# Uso: .harness/push            envio normal
#      .harness/push --force    depois de reescrever commits já enviados (com lease)
#
# É o único caminho do agente até o remoto: dentro do sandbox a rede para o servidor
# de git é negada, e este script roda fora dele. Por isso não executa código do
# projeto (nem a validação: ela roda antes, dentro do sandbox, por .harness/validate)
# e ignora variáveis de ambiente do git.
set -uo pipefail
. "$(dirname "$0")/env-common.sh"
for VAR in $(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p'); do unset "$VAR"; done

FORCE=""
case "$#:${1:-}" in
  0:) ;;
  1:--force) FORCE="--force-with-lease" ;;
  *) echo "uso: push [--force]" >&2; exit 2 ;;
esac

cd "$ROOT" || exit 1
BRANCH="$(git symbolic-ref --short -q HEAD)" || die "o push é sempre de uma branch; este checkout não está em nenhuma."
URL="$(git remote get-url origin 2>/dev/null)" || die "este repositório não tem o remoto origin."
SHA="$(git rev-parse HEAD)"

printf 'refs/heads/%s %s refs/heads/%s 0000000000000000000000000000000000000000\n' "$BRANCH" "$SHA" "$BRANCH" \
  | "$HERE/gate-check" "$URL" || exit 1

# shellcheck disable=SC2086
git push --no-verify $FORCE origin "HEAD:refs/heads/$BRANCH" || die "o remoto recusou o envio. Veja a saída do git acima."
echo "Branch $BRANCH enviada ($SHA)."
