#!/usr/bin/env bash
# Adota o harness num projeto, num comando só.
# Uso: npx @fullchico/harness install [pasta do projeto] [--profile <perfil>] [--force]
#      <pasta do harness>/install [pasta do projeto] [--profile <perfil>] [--force]   (num clone)
#
# Perfis: fullstack-typescript (padrão; a stack e as skills dela), livre (projeto novo em
# outra stack) e existente (projeto que já tinha código; não impõe arquitetura nem língua).
#
# Grava os arquivos gerenciados, registra os marketplaces, instala os plugins no
# escopo do projeto e prepara o worktree. Pode ser rodado de novo sem dano.
# Variável: HARNESS_SKIP_PLUGIN=1 não chama o `claude`.
set -uo pipefail

HARNESS="$(cd "$(dirname "$0")" && pwd -P)"
PROJECT="." FORCE="" PROFILE="" WANT_PROFILE=""
for ARG in "$@"; do
  if [ -n "$WANT_PROFILE" ]; then PROFILE="$ARG"; WANT_PROFILE=""; continue; fi
  case "$ARG" in
    --force) FORCE="--force" ;;
    --profile) WANT_PROFILE=1 ;;
    --profile=*) PROFILE="${ARG#--profile=}" ;;
    -*) echo "uso: install [pasta do projeto] [--profile fullstack-typescript|livre|existente] [--force]" >&2; exit 2 ;;
    *) PROJECT="$ARG" ;;
  esac
done

ROOT="$(git -C "$PROJECT" rev-parse --show-toplevel 2>/dev/null)" || {
  echo "install: $PROJECT não é um repositório git." >&2; exit 2; }
command -v python3 >/dev/null 2>&1 || { echo "install: falta o python3." >&2; exit 2; }

VERSION="v$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1]))["version"])' \
  "$HARNESS/plugin/.claude-plugin/plugin.json")" || exit 1

# shellcheck disable=SC2086
python3 -I "$HARNESS/plugin/bin/sync" "$ROOT" --version "$VERSION" $FORCE ${PROFILE:+--profile "$PROFILE"} || exit $?
# O perfil que vale é o que ficou no harness.conf: o pedido agora, ou o de uma instalação anterior.
PROFILE="$(sed -n 's/^PROFILE=//p' "$ROOT/harness.conf" | tr -d "\"'" | sed -n 1p)"
PROFILE="${PROFILE:-fullstack-typescript}"

# Mostra em que ponto está: registrar plugins e baixar skills leva mais de um minuto, e em
# silêncio parece travado. Num terminal, um trem anda pelo trilho ao lado do passo atual; fora
# dele sai uma linha por passo, sem desenho.
ANIM="" LABEL=""
stop_train() {
  [ -n "$ANIM" ] || return 0
  { kill "$ANIM" && wait "$ANIM"; } 2>/dev/null
  ANIM=""
}
if [ -t 1 ]; then
  LABEL="$(mktemp)"
  trap 'stop_train; rm -f "$LABEL"' EXIT
  train() {  # o trem vai da esquerda à direita do trilho e recomeça; a fumaça fica para trás
    local at=0 width=16 smoke left right
    while :; do
      case $((at % 3)) in 0) smoke=".oO" ;; 1) smoke="oO." ;; *) smoke="O.o" ;; esac
      left="$(printf '%*s' "$at" '' | tr ' ' '=')"
      right="$(printf '%*s' "$((width - at))" '' | tr ' ' '=')"
      printf '\r\033[K%s%s[##]D%s  %s' "$left" "$smoke" "$right" "$(cat "$LABEL" 2>/dev/null)"
      at=$(((at + 1) % (width + 1)))
      sleep 0.12
    done
  }
  progress() { printf '%s' "$1" > "$LABEL"; [ -n "$ANIM" ] || { train & ANIM=$!; }; }
  settle() { stop_train; printf '\r\033[K%s\n' "$1"; }
else
  progress() { echo "$1"; }
  settle() { :; }
fi
echo "[1/3] Arquivos do harness gravados"

if [ -z "${HARNESS_SKIP_PLUGIN:-}" ] && command -v claude >/dev/null 2>&1; then
  warn() { [ -t 1 ] && printf '\r\033[K'; echo "install: não consegui $1; rode à mão: $2" >&2; }
  # Num clone do repositório, o marketplace é esta pasta (desenvolvimento do próprio harness).
  # Instalado pelo npm, a pasta é o cache do npx e some: vale o repositório publicado.
  if [ -d "$HARNESS/.git" ] || [ -f "$HARNESS/.git" ]; then MARKET="$HARNESS"; else MARKET="FullChico/fullchico-harness"; fi
  MARKET="${HARNESS_MARKETPLACE:-$MARKET}"
  progress "[2/3] Plugins: registrando os marketplaces"
  claude plugin marketplace add "$MARKET" >/dev/null 2>&1 || warn "registrar o marketplace do harness" "claude plugin marketplace add $MARKET"
  REPOS="$(python3 -I - "$ROOT/.claude/settings.json" <<'PY'
import json, sys
for name, entry in json.load(open(sys.argv[1])).get("extraKnownMarketplaces", {}).items():
    source = entry.get("source", {})
    if name != "fullchico" and source.get("source") == "github" and source.get("repo"):
        print(source["repo"])
PY
)"
  for REPO in $REPOS; do
    claude plugin marketplace add "$REPO" >/dev/null 2>&1 || warn "registrar o marketplace $REPO" "claude plugin marketplace add $REPO"
  done
  # Instalar é por projeto: o comando roda de dentro dele.
  PLUGINS="$(python3 -I - "$ROOT/.claude/settings.json" <<'PY'
import json, sys
for name, enabled in json.load(open(sys.argv[1])).get("enabledPlugins", {}).items():
    if enabled:
        print(name)
PY
)"
  TOTAL="$(printf '%s\n' $PLUGINS | grep -c .)" N=0
  for PLUGIN in $PLUGINS; do
    N=$((N + 1))
    progress "[2/3] Plugins ($N/$TOTAL): $PLUGIN"
    (cd "$ROOT" && claude plugin install "$PLUGIN" --scope project >/dev/null 2>&1) || warn "instalar $PLUGIN" "claude plugin install $PLUGIN --scope project"
  done
  settle "[2/3] Plugins instalados ($TOTAL)"
else
  echo "install: sem o comando claude; os plugins ficam para depois." >&2
fi

# Skills de arquitetura, dos autores, copiadas para o projeto e fixadas no skills-lock.json.
if [ -z "${HARNESS_SKIP_PLUGIN:-}" ] && command -v npx >/dev/null 2>&1; then
  SKILLS="$(python3 -I -c 'import json,sys
for s in json.load(open(sys.argv[1])).get("project_skills", []):
    if sys.argv[2] in s.get("profiles", []):
        print(s["repo"] + "|" + s["skill"])' "$HARNESS/plugin/map.json" "$PROFILE")"
  TOTAL="$(printf '%s\n' $SKILLS | grep -c .)" N=0
  for PAIR in $SKILLS; do
    REPO="${PAIR%%|*}" SKILL="${PAIR##*|}"
    N=$((N + 1))
    progress "[3/3] Skills ($N/$TOTAL): $SKILL"
    [ -d "$ROOT/.claude/skills/$SKILL" ] && continue
    (cd "$ROOT" && npx -y skills add "$REPO" -s "$SKILL" -a claude-code -y --copy </dev/null >/dev/null 2>&1) \
      || { [ -t 1 ] && printf '\r\033[K'; echo "install: não instalei a skill $SKILL; rode à mão: npx skills add $REPO -s $SKILL -a claude-code -y --copy" >&2; }
  done
  [ "$TOTAL" -eq 0 ] || settle "[3/3] Skills instaladas ($TOTAL)"
fi

# Com o harness.conf já preenchido, deixa o worktree pronto: portas no .env e dependências.
NEXT="O harness.conf é preenchido na primeira entrega. Se o projeto já tem código, rode antes /harness:setup, que o propõe a partir do que encontra."
if grep -Eq '^PROJECT="?[^"[:space:]]' "$ROOT/harness.conf" 2>/dev/null; then
  HARNESS_SKIP_PLUGIN=1 "$ROOT/.harness/setup-worktree" || exit $?
  NEXT="O harness.conf já estava preenchido: portas gravadas no .env e dependências instaladas."
fi

stop_train
[ -t 1 ] && printf '\r\033[K'
if [ -n "${CLAUDECODE:-}" ]; then
  cat >&2 <<'EOT'

install: você está dentro de uma sessão do Claude Code, e o sandbox dela bloqueia o GitHub: o
plugin pode não ter sido instalado. Os arquivos do projeto foram gravados. Para completar, rode
este mesmo comando no seu terminal, fora da sessão; ele pode ser repetido sem dano:
  npx @fullchico/harness install <pasta do projeto>
EOT
fi

cat <<EOT

Harness $VERSION instalado em $ROOT, no perfil $PROFILE.
$NEXT
Pronto. Abra o Claude Code nessa pasta (na primeira vez, aceite a confiança da pasta) e peça:
  /harness:entregar <o que você quer construir>
EOT
